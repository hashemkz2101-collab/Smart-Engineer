# Template of the environment variables the API reads. Copy values into your own
# shell or process manager; the application reads the process environment and
# does not load this file automatically. Never put secrets in this file or
# commit a real .env file.

# development | test | production (default: development)
SMART_ENGINEER_ENV=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
SMART_ENGINEER_LOG_LEVEL=INFO
