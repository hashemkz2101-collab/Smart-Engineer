# Template of the environment variables the API reads. Copy values into your own
# shell or process manager; the application reads the process environment and
# does not load this file automatically. Never put secrets in this file or
# commit a real .env file.

# development | test | production (default: development)
SMART_ENGINEER_ENV=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
SMART_ENGINEER_LOG_LEVEL=INFO

# SQLAlchemy URL for the database (optional until a feature needs it). Use
# PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# (sqlite:// URLs are accepted outside production, for tests only).
# SMART_ENGINEER_DATABASE_URL=

# Optional: URL of a DISPOSABLE PostgreSQL database for the migration tests.
# The tests drop its tables. Never point this at real data.
# SMART_ENGINEER_TEST_DATABASE_URL=

# Email delivery over SMTP (needed in production; DEC-010). Any provider's SMTP relay
# works. Put the real password only in the server's environment, never in this file.
# Malware scanning with ClamAV on your own server (SEC-002). Without it, production keeps
# uploaded files pending (not downloadable). Use host+port or a Unix socket path.
# SMART_ENGINEER_CLAMAV_HOST=127.0.0.1
# SMART_ENGINEER_CLAMAV_PORT=3310
# SMART_ENGINEER_CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
# SMART_ENGINEER_CLAMAV_TIMEOUT=30
# SMART_ENGINEER_PUBLIC_URL=https://your-site.example
# SMART_ENGINEER_SMTP_HOST=smtp.provider.example
# SMART_ENGINEER_SMTP_PORT=587
# SMART_ENGINEER_SMTP_SECURITY=starttls
# SMART_ENGINEER_SMTP_USERNAME=
# SMART_ENGINEER_SMTP_PASSWORD=
# SMART_ENGINEER_MAIL_FROM=no-reply@your-site.example
